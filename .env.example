# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# set this to the public origin when running behind a reverse proxy
# AUTH_URL=https://chat.example.com

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# Moanachat can also be launched by a New API Chat Preset. Use a URL such as
# https://moana.example.com/?apiBase={address}/v1&apiKey={key}
# in New API's Chats setting. The embedded values are temporary runtime input
# and are stored in an HttpOnly cookie after the page loads.

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****
